# Variables de entorno — BankCore
# Copia este archivo como .env y ajusta valores. NUNCA subas .env al repositorio
# (ver SRS #29). El backend las lee del entorno; Docker Compose lee .env automáticamente.

# JDBC URL del PostgreSQL local (ver docker-compose.yml).
DATABASE_URL=jdbc:postgresql://localhost:5432/bankcore
# Usuario de la base de datos (también POSTGRES_USER del contenedor).
DATABASE_USERNAME=bankcore
# Password de la base de datos (también POSTGRES_PASSWORD del contenedor).
DATABASE_PASSWORD=bankcore
# Nombre de la base de datos creada por el contenedor.
POSTGRES_DB=bankcore
# Puerto publicado del contenedor en tu máquina.
POSTGRES_PORT=5432
# Secreto para firmar los JWT de acceso. Cambia este valor en cualquier ambiente real.
JWT_SECRET=change-me
# Duración del access token JWT, en minutos (TECHNICAL-DESIGN #16: 15).
ACCESS_TOKEN_TTL_MINUTES=15
# Duración del refresh token persistido, en días (TECHNICAL-DESIGN #58: parametrizable).
REFRESH_TOKEN_TTL_DAYS=30
